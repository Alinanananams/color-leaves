<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Target Name="CopyAddin" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'ColorLeaves.Revit'">
    <PropertyGroup>
      <AddinFile>$(MSBuildThisFileDirectory)addins\$(RevitYear)\ColorLeaves.addin</AddinFile>
      <DeployDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitYear)\</DeployDir>
      <DeployLibDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitYear)\ColorLeaves\</DeployLibDir>
    </PropertyGroup>
    <MakeDir Directories="$(DeployLibDir)" />
    <Copy SourceFiles="$(AddinFile)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployLibDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)ColorLeaves.Core.dll" DestinationFolder="$(DeployLibDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Resources\sheet.png;$(MSBuildProjectDirectory)\Resources\parameter.png;$(MSBuildProjectDirectory)\Resources\settings.png" DestinationFolder="$(DeployLibDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
